# CSRF_TRUSTED_ORIGINS=https://kylymy.onrender.com,https://kylymy.ua

# Database (local dev — SQLite via dev.py; prod — Render PostgreSQL)
DATABASE_URL=postgres://kylymy:kylymy@localhost:5432/kylymy

# Redis (local dev — не потрібен, dev.py використовує LocMemCache)
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@kylymy.ua
ADMIN_EMAIL=admin@kylymy.ua

# Telegram
TELEGRAM_BOT_TOKEN=
